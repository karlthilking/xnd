# xnd house style: GNU, as written in include/common/atomic.h,
# xnd/workq.c, xnd/xnd_lib.c and xnd/synch/.
#
# Vendored sources (macos/libdispatch) are excluded via .clang-format-ignore.
---
Language:                             Cpp
BasedOnStyle:                         GNU

ColumnLimit:                          79
IndentWidth:                          2
TabWidth:                             8
UseTab:                               Never
ContinuationIndentWidth:              4

# GNU layout: braces on their own line, indented for blocks inside a
# function; return type on its own line above the definition.
BreakBeforeBraces:                    GNU
AlwaysBreakAfterReturnType:           AllDefinitions
SpaceBeforeParens:                    Always
PointerAlignment:                     Right

# This tree is macro-dense; keep hand-aligned continuations aligned and
# never let a short helper collapse onto one line.
AlignEscapedNewlines:                 Left
AllowShortFunctionsOnASingleLine:     None
AllowShortIfStatementsOnASingleLine:  Never
AllowShortLoopsOnASingleLine:         false
AllowShortBlocksOnASingleLine:        Never
AllowShortCaseLabelsOnASingleLine:    false
AlignConsecutiveMacros:               true
AlignTrailingComments:                false

# Include order is load-bearing (compiler.h, interpose.h, wrapper
# headers); never reorder it.
SortIncludes:                         Never
IncludeBlocks:                        Preserve

# Block comments are hand-wrapped; leave their prose alone.
ReflowComments:                       false
BreakStringLiterals:                  false

# Brace removal changes code, not just whitespace - keep it out of a
# style-only pass.
RemoveBracesLLVM:                     false
InsertBraces:                         false

MaxEmptyLinesToKeep:                  1
KeepEmptyLinesAtTheStartOfBlocks:     false
IndentCaseLabels:                     false
IndentGotoLabels:                     false
BreakBeforeBinaryOperators:           NonAssignment
AlignAfterOpenBracket:                Align
BinPackArguments:                     true
BinPackParameters:                    true
---
Language:                             ObjC
BasedOnStyle:                         GNU

ColumnLimit:                          79
IndentWidth:                          2
TabWidth:                             8
UseTab:                               Never
ContinuationIndentWidth:              4

# GNU layout: braces on their own line, indented for blocks inside a
# function; return type on its own line above the definition.
BreakBeforeBraces:                    GNU
AlwaysBreakAfterReturnType:           AllDefinitions
SpaceBeforeParens:                    Always
PointerAlignment:                     Right

# This tree is macro-dense; keep hand-aligned continuations aligned and
# never let a short helper collapse onto one line.
AlignEscapedNewlines:                 Left
AllowShortFunctionsOnASingleLine:     None
AllowShortIfStatementsOnASingleLine:  Never
AllowShortLoopsOnASingleLine:         false
AllowShortBlocksOnASingleLine:        Never
AllowShortCaseLabelsOnASingleLine:    false
AlignConsecutiveMacros:               true
AlignTrailingComments:                false

# Include order is load-bearing (compiler.h, interpose.h, wrapper
# headers); never reorder it.
SortIncludes:                         Never
IncludeBlocks:                        Preserve

# Block comments are hand-wrapped; leave their prose alone.
ReflowComments:                       false
BreakStringLiterals:                  false

# Brace removal changes code, not just whitespace - keep it out of a
# style-only pass.
RemoveBracesLLVM:                     false
InsertBraces:                         false

MaxEmptyLinesToKeep:                  1
KeepEmptyLinesAtTheStartOfBlocks:     false
IndentCaseLabels:                     false
IndentGotoLabels:                     false
BreakBeforeBinaryOperators:           NonAssignment
AlignAfterOpenBracket:                Align
BinPackArguments:                     true
BinPackParameters:                    true
ObjCBlockIndentWidth:                 2
